# OmniTrade - Binance Testnet Configuration (Phase 11)
# Copy this file to .env and fill in your testnet credentials.
# NEVER commit real credentials. .env is gitignored.
#
# Get testnet credentials at: https://testnet.binance.vision/

# REQUIRED: must be exactly "testnet" for Phase 11. Any other value
# causes the BinanceTestnetBroker to fail-closed (no orders).
BINANCE_ENV=testnet

# Binance Testnet API credentials (spot testnet)
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Optional: override base URL (must contain "testnet" if set)
# BINANCE_BASE_URL=https://testnet.binance.vision

# Redis (existing)
# REDIS_URL=redis://localhost:6379/0
